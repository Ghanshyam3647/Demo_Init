pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checked Out'
            }
        }
        stage('Build') {
            steps {
                echo 'Built'
            }
        }
        stage('Test') {
            steps {
                echo 'TESTING'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deployed'
            }
        }
    }
}
